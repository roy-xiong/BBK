+/**
+ * 将战死武将的两件装备放回战斗城市，并按原版规则标记为已经发现。
+ */
+static void ReturnLoserEquipment(PersonID person,U8 city)
+{
+    ToolID *gptr = g_Persons[person].Equip;
+    if (gptr[0])
+    {
+        ToolID index = AddGoods(city,TID(gptr[0] - 1));
+        SetGoodsByIndex(TID(index - 1));
+    }
+    if (gptr[1])
+    {
+        ToolID index = AddGoods(city,TID(gptr[1] - 1));
+        SetGoodsByIndex(TID(index - 1));
+    }
+    gptr[0] = 0;
+    gptr[1] = 0;
+}
+
+/** 回收装备并彻底清理战死人物，避免仍被识别为旧势力君主或重复生成装备。 */
+static void MarkPersonDead(PersonID person,U8 city)
+{
+    PersonType *pptr = &g_Persons[person];
+    /* 在归属与剩余兵力被清空前报告真实死亡。俘虏、逃跑和同一次重复清理不计阵亡。 */
+    if (pptr->Belong && pptr->Belong != PID(0xffff) && city < CITY_MAX) {
+        PersonID winnerBelong = g_Cities[city].Belong;
+        IF_HAS_HOOK("battleGeneralDied") {
+            BIND_U16EX("personIndex", &person);
+            BIND_U16EX("belong", &pptr->Belong);
+            BIND_U32EX("arms", &pptr->Arms);
+            BIND_U16EX("winnerBelong", &winnerBelong);
+            CALL_HOOK_S();
+        }
+    }
+    ReturnLoserEquipment(person,city);
+    pptr->OldBelong = pptr->Belong;
+    pptr->Belong = PID(0xffff);
+    pptr->Arms = 0;
+}
+
+/**
+ * 把人物标记为俘虏。是否加入城市队列由调用方决定，避免城内未参战人物重复入队。
+ */
+static void MarkLoserCaptive(PersonID person)
+{
+    PersonType *pptr = &g_Persons[person];
+    pptr->OldBelong = pptr->Belong;
+    pptr->Belong = PID(0xffff);
+    pptr->Arms = 0;
+    cavpdb = person;
+    cavps += 1;
+}
+
+/**
+ * 把战败人物改为在野。参战人物已离开城市队列，需要由调用方指定重新加入战斗城市。
+ */
+static void MakeLoserWild(PersonID person,U8 city,U8 addToCity)
+{
+    PersonType *pptr = &g_Persons[person];
+    pptr->OldBelong = pptr->Belong;
+    pptr->Belong = PID0;
+    pptr->Arms = 0;
+    if (addToCity)
+        AddPerson(city,person);
+}
