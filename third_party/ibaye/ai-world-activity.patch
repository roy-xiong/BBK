+/**
+ * 检查本条敌方外交命令是否会影响玩家武将或玩家城池。
+ *
+ * 只在结算时校验当前归属，兼容排队后易主的目标；战斗、内政与玩家外交不受影响。
+ * 策反会改变整座城市，故目标暂时属于其他势力时仍须保护其所在的玩家城市。
+ * @param Order 即将结算的命令。
+ * @return 应阻止命令时为1。
+ */
+static U8 IsProtectedPlayerDiplomacy(OrderType *Order)
+{
+    U8 city;
+    PersonID player = PID(g_PlayerKing + 1);
+    if (!Order || !g_engineConfig.playerDiplomacyProtection ||
+        Order->Person >= PERSON_COUNT || Order->Object >= PERSON_COUNT ||
+        g_Persons[Order->Person].Belong == player)
+        return 0;
+    switch (Order->OrderId)
+    {
+        case SURRENDER: case ALIENATE: case CANVASS:
+        case COUNTERESPIONAGE: case REALIENATE: case INDUCE:
+            if (g_Persons[Order->Object].Belong == player)
+                return 1;
+            if (Order->OrderId == COUNTERESPIONAGE)
+            {
+                city = GetPersonCity(Order->Object);
