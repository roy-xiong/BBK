+/**
+ * 返回电脑出征目标的固定优先级，与世界活跃度无关。
+ *
+ * @param city 已通过边界检查的目标城市编号。
+ * @return 0表示无人城，1表示玩家城，2表示其他势力城。
+ */
+static U8 AiTargetPriority(U8 city)
+{
+    PersonID belong = g_Cities[city].Belong;
+    if (!belong)
+        return 0;
+    return belong == (g_PlayerKing + 1) ? 1 : 2;
+}
