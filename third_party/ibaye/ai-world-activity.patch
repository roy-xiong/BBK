+/**
+ * 按战略地图坐标计算目标城市看向出发城市的方向。
+ *
+ * 非相邻城市没有 CITY_LINKR 方向槽位；战场初始化仍要求 0～7 的合法方向，因此根据
+ * 两城相对位置生成最近的八方向，确保远程出征不会越界读取战场初始站位表。
+ */
+static U8 GetCityPositionDirect(U8 targetCity,U8 sourceCity)
+{
+    U8 *positions = ResLoadToCon(IFACE_CONID,dCityPos,g_CBnkPtr);
+    I16 dx = (I16)positions[sourceCity * 2] - (I16)positions[targetCity * 2];
+    I16 dy = (I16)positions[sourceCity * 2 + 1] - (I16)positions[targetCity * 2 + 1];
+
+    if (dy < 0)
+    {
+        if (dx < 0) return DIRECT_WN;
+        if (dx > 0) return DIRECT_EN;
+        return DIRECT_N;
+    }
+    if (dy > 0)
+    {
+        if (dx < 0) return DIRECT_WS;
+        if (dx > 0) return DIRECT_ES;
+        return DIRECT_S;
+    }
+    return dx < 0 ? DIRECT_W : DIRECT_E;
+}
