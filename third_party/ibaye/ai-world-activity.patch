+/** 扣除实际兵力，返回真实伤亡；不允许16位截断或无符号下溢。 */
+FAR U32 CountArmsSub(U32 *a,U32 value)
+{
+    U32 loss = *a < value ? *a : value;
+    *a -= loss;
+    return loss;
+}
+
+/** 治疗只增加至上限，超出统率上限的原有兵力不因治疗被反向扣减。 */
+FAR U32 CountArmsAdd(U32 *a,U32 value,U32 upper)
+{
+    if (*a >= upper) return 0;
+    U32 addition = upper - *a < value ? upper - *a : value;
+    *a += addition;
+    return addition;
+}
