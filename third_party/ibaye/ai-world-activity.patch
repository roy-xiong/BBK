+#define AI_WORLD_ACTIVITY_ORIGINAL 25
+
+static U8 AiWorldActivity(void)
+{
+    return g_engineConfig.aiWorldActivity > 100 ? 100 : g_engineConfig.aiWorldActivity;
+}
+
+static U8 AiWorldActivityBonus(void)
+{
