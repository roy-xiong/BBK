+/*
+ * 世界活跃度只修正电脑发起的外交命令。25保持原版成功率；100最多为最终性格
+ * 判定增加20个百分点，并温和修正智力、忠诚门槛。玩家手动命令完全沿用原公式。
+ */
+static U32 AiDiplomacyBonus(PersonID person)
+{
+    U8 activity;
+    if (person >= PERSON_COUNT || g_Persons[person].Belong == g_PlayerKing + 1)
+        return 0;
+    activity = g_engineConfig.aiWorldActivity > 100 ? 100 : g_engineConfig.aiWorldActivity;
+    if (activity <= 25)
+        return 0;
+    return ((U32)(activity - 25) * 20) / 75;
+}
+
+static U32 AddChanceBonus(I32 chance,U32 bonus)
+{
+    I32 adjusted = chance + (I32)bonus;
+    if (adjusted <= 0)
+        return 0;
+    return adjusted > 100 ? 100 : (U32)adjusted;
+}
+
+static U32 ReduceDevotion(U32 devotion,U32 bonus)
+{
+    return devotion > bonus ? devotion - bonus : 0;
+}
+
+/**
+ * 命令结束后把执行者放回仍属于其当前势力的城市。
+ *
+ * 外交、战斗和君主更替可能在命令执行期间改变原城市或人物归属。人物已经被其他
+ * 逻辑放入城市时不重复添加；原城市已易主时改投当前势力的首座城市；势力确实已经
+ * 无城时才转为在野并留在原城市，避免旧势力人物重新塞回敌方城市。
+ */
+static void ReturnOrderPerson(OrderType *Order,PersonID person)
+{
+    U8 cities[CITY_MAX];
+    U8 cityCount;
+    PersonID belong;
+    PersonType *pptr;
+
+    if (!Order || person >= PERSON_COUNT || GetPersonCity(person) != 0xff)
+        return;
+    pptr = &g_Persons[person];
+    belong = pptr->Belong;
+    if (!belong || belong == PID(0xffff))
+        return;
+    if (Order->City < CITY_MAX && g_Cities[Order->City].Belong == belong)
+    {
+        AddPerson(Order->City,person);
+        return;
+    }
+    cityCount = GetKingCitys(PID(belong - 1),cities);
+    if (cityCount)
+    {
+        AddPerson(cities[0],person);
+        return;
+    }
+    if (Order->City < CITY_MAX)
+    {
+        pptr->OldBelong = belong;
+        pptr->Belong = PID0;
+        AddPerson(Order->City,person);
+    }
+}
