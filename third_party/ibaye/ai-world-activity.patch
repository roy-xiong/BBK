-FAR U16 PlcArmsMax(PersonID id) {
+/** 计算兵力平方根时保留16位结果，避免sqrt(200000)被截断到8位。 */
+FAR U16 PlcExtractArms(U32 num)
+{
+    return sqrt32(num);
+}
+
+/**
+ * 获取敌将的带兵上限覆盖值。开关关闭、我方、在野和俘虏均沿用原版计算。
+ * 这里只查询上限，不修改现有兵力；后续征兵和分配通过PlcArmsMax使用该值。
+ * @param person 当前武将，允许为空。
+ * @return 开启作弊时返回800~200000；返回0表示没有覆盖原版算法。
+ */
+FAR U32 PlcArmsLimit(PersonType *person)
+{
+    if (person && person->Belong && person->Belong != PID(0xffff) &&
+        person->Belong != PID(g_PlayerKing + 1) && g_engineConfig.enemyArmsLimitEnabled)
+    {
+        U32 limit = g_engineConfig.enemyArmsLimit;
+        if (limit < 800) limit = 800;
+        if (limit > PERSON_ARMS_MAX) limit = PERSON_ARMS_MAX;
+        return limit;
+    }
+    return 0;
+}
+
+FAR U32 PlcArmsMax(PersonID id) {
+    if (id >= PERSON_COUNT)
+        return 0;
+    /* 覆盖值必须先于资源脚本处理，防止精修版getMaxArms仍把敌将锁在原版上限。 */
+    U32 limit = PlcArmsLimit(&g_Persons[id]);
+    if (limit)
+        return limit;
     IF_HAS_HOOK("getMaxArms") {
         U32 maxArms = 0;
         BIND_U16EX("personIndex", &id);
         BIND_U32(&maxArms);
         if (CALL_HOOK() == 0) {
-            HOOK_RETURN(maxArms);
+            /* 未开启覆盖时保留原版函数的16位返回语义。 */
+            HOOK_RETURN((U16)maxArms);
         }
     }
