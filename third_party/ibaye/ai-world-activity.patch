+/**
+ * 收集指定势力全部可继承人物，包括驻城人物、执行普通命令者和出征队伍。
+ *
+ * 原版只统计驻城人物，势力所有将领恰好都在执行命令时会被误判为无人继承，进而把
+ * 未被攻击的城市全部清为无主。这里按人物编号去重，并以人物当前归属作为最终依据。
+ */
+static U32 GetKingPersonsWithOrders(PersonID king,PersonID *persons)
+{
+    U8 seen[PERSON_MAX];
+    OrderType *orders = (OrderType*)ORDERQUEUE;
+    U32 count,i,j;
+    PersonID belong = PID(king + 1);
+
+    gam_memset(seen,0,sizeof(seen));
+    count = GetKingPersons(king,persons);
+    for (i = 0;i < count;i ++)
+    {
+        if (persons[i] < PERSON_COUNT)
+            seen[persons[i]] = 1;
+    }
+    for (i = 0;i < ORDER_MAX;i ++)
+    {
+        if (orders[i].OrderId == 0xff)
+            continue;
+        if (orders[i].OrderId == BATTLE)
+        {
+            PersonID *fighters = FightOrderPersons((U8)orders[i].Person);
+            if (!fighters)
+                continue;
+            for (j = 0;j < FIGHTERS_PER_ORDER;j ++)
+            {
+                PersonID person;
+                if (!fighters[j])
+                    continue;
+                person = PID(fighters[j] - 1);
+                if (person >= PERSON_COUNT || seen[person] ||
+                    g_Persons[person].Belong != belong)
+                    continue;
+                seen[person] = 1;
+                persons[count++] = person;
+            }
+            continue;
+        }
+        if (orders[i].Person < PERSON_COUNT && !seen[orders[i].Person] &&
+            g_Persons[orders[i].Person].Belong == belong)
+        {
+            seen[orders[i].Person] = 1;
+            persons[count++] = orders[i].Person;
+        }
+    }
+    return count;
+}
