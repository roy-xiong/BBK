+/**
+ * 获取敌方战败人员沿原势力城市连线能够到达的撤退城市。
+ *
+ * 战斗城市无论结算时是否已经易主，都只作为路径起点；第一步和后续城市必须仍属于
+ * 逃跑人员原势力，因此不能穿过玩家、第三方或无人占领城市到达远方据点。
+ */
+static U8 GetRouteEscapeCities(PersonID person,U8 city,U8 *cities)
+{
+    PersonID belong;
+    U8 *links;
+    U8 *cityLinks;
+    U8 visited[CITY_MAX];
+    U8 queue[CITY_MAX];
+    U8 head,tail,count,current,next,i;
+
+    if (person >= PERSON_COUNT || city >= CITY_MAX || !cities)
+        return 0;
+    belong = g_Persons[person].Belong;
+    if (!belong || belong == PID(0xffff))
+        return 0;
+
+    links = ResLoadToCon(CITY_LINKR,1,g_CBnkPtr);
+    gam_memset(visited,0,sizeof(visited));
+    head = 0;
+    tail = 0;
+    count = 0;
+    visited[city] = 1;
+    queue[tail++] = city;
+
+    while (head < tail)
+    {
+        current = queue[head++];
+        cityLinks = links + current * 16;
+        for (i = 0;i < 8;i ++)
+        {
+            if (!cityLinks[i])
+                continue;
+            next = cityLinks[i] - 1;
+            if (next >= CITY_MAX || visited[next] || g_Cities[next].Belong != belong)
+                continue;
+            visited[next] = 1;
+            queue[tail++] = next;
+            cities[count++] = next;
+        }
+    }
+    return count;
+}
